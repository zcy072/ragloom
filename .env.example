# 复制为 .env 后按需填写。这里只列出部署时需要填写或常改的变量；
# 其余变量都有合理默认值，完整列表、默认值和取值范围见 docs/development/配置项.md，
# 需要时直接加到 .env 中即可。修改后用 docker compose up -d 重新创建容器。

# ===== 必填 =====
# 模型 API Key 的加密主密钥，必须是标准 Fernet 密钥（32 字节随机数的 URL 安全 base64），每套部署单独生成：
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# 不要提交或丢失此值；只有数据库而没有该值时，无法恢复已保存的模型 API Key。
MODEL_API_KEY_ENCRYPTION_KEY=

# ===== 模型与解析（按需）=====
# SiliconFlow Key（嵌入与重排）。只在首次建库时导入数据库，之后以“模型管理”中保存的值为准，
# 修改此处不再生效。
SILICONFLOW_API_KEY=
# MinerU 云端解析 Token，选择“MinerU 云端解析”处理 PDF 或 DOCX 时需要。
MINERU_API_TOKEN=
# 图片分析：auto（视觉模型，失败时改用本地 OCR）、ocr（只用本地 OCR）、disabled（跳过图片）。
# 不希望图片外发时设为 ocr。
RAG_IMAGE_ANALYSIS=auto

# ===== 账户 =====
# admin 的初始密码，只在首次建库时生效；留空时随机生成并写入
# storage/data/initial_admin_password.txt。
INITIAL_ADMIN_PASSWORD=

# 通过 HTTPS 访问时设为 true，使登录 Cookie 只经 HTTPS 发送；本机 HTTP 调试保持 false。
AUTH_COOKIE_SECURE=false

# ===== 性能 =====
# 并行索引的文档数（1~8）。OCR、MinerU、嵌入、视觉模型各自的并发上限见配置文档。
INDEX_WORKER_THREADS=3

# ===== 构建与部署（仅 docker compose 使用）=====
TZ=Asia/Shanghai
# 构建容器直连官方 PyPI 很慢时（国内常见），改为 https://pypi.tuna.tsinghua.edu.cn/simple
PIP_INDEX_URL=https://pypi.org/simple
# Docker Hub 基础镜像前缀与 npm 源，默认国内镜像；镜像站不可用时改为 docker.io/library
# 和 https://registry.npmjs.org/。Milvus 镜像见配置文档中的 MILVUS_IMAGE。
DOCKER_LIBRARY_PREFIX=docker.m.daocloud.io/library
NPM_REGISTRY=https://registry.npmmirror.com/
# 仅在 Linux 出现 storage/ 权限错误时改成 `id -u` 和 `id -g` 的输出并重新构建后端。
APP_UID=1000
APP_GID=1000
