# Docker 容器和服务日志使用的本地时区；数据库时间仍统一保存为带偏移的 UTC。
TZ=Asia/Shanghai

# 后端容器写入 storage/ 时使用的宿主机 UID/GID。通常保留默认值即可；仅在 Linux
# 出现 storage/ 权限错误时，才改成 `id -u` 和 `id -g` 的输出并重新构建后端。
APP_UID=1000
APP_GID=1000

# ===== 构建网络（仅 docker compose build 时生效）=====
# Docker Hub 基础镜像前缀，默认 Daocloud 镜像。镜像站不可用时改回官方源：docker.io/library
DOCKER_LIBRARY_PREFIX=docker.m.daocloud.io/library
# Python 包索引。
PIP_INDEX_URL=https://pypi.org/simple
# 前端 npm 源。
NPM_REGISTRY=https://registry.npmmirror.com/

# MinerU 云端文档解析 Token。只有选择“MinerU 云端解析”处理 PDF 或 DOCX 时才需要填写。
MINERU_API_TOKEN=
# MinerU 接口地址、模型版本和结果下载重试次数，一般无需修改。
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
MINERU_DOWNLOAD_ATTEMPTS=3
# MinerU 单个文档的整体处理超时（秒），范围 30~3600。
MINERU_TIMEOUT_SECONDS=600

# 后端日志级别。
LOG_LEVEL=INFO
# 检索器缓存最多保留的知识库数量。
RETRIEVER_CACHE_MAX_SIZE=8
# 查询嵌入缓存条目数。
QUERY_EMBEDDING_CACHE_SIZE=64

# ===== 图片分析 =====
# 图片分析策略：auto（视觉模型，失败回退本地 OCR）、ocr（仅本地 OCR）、disabled（跳过图片）。
RAG_IMAGE_ANALYSIS=auto
# 视觉模型所用的提供商，名称须与“模型管理”中的提供商一致。
RAG_VISION_PROVIDER=OpenAI
# 可选：覆盖模型管理中该提供商的模型、接口地址和 API Key，通常留空。
RAG_VISION_MODEL=
RAG_VISION_BASE_URL=
RAG_VISION_API_KEY=
# 视觉模型请求超时（秒）。
RAG_VISION_TIMEOUT_SECONDS=60

# 索引并发。INDEX_WORKER_THREADS 是同时处理的文档数（1~8，默认 3），设为 1 即退回串行。
# 下面几项限制所有索引任务合计占用某类资源的上限：
# OCR 本地推理（1~4，默认 1）、MinerU 云解析（1~8，默认 3）、
# 嵌入请求（1~8，默认 2）、视觉模型请求（1~32，默认 6，跨文档合计）。
# 接口限流较严格时调低对应项即可。
INDEX_WORKER_THREADS=3
OCR_MAX_CONCURRENCY=1
MINERU_MAX_CONCURRENCY=3
EMBEDDING_MAX_CONCURRENCY=2
VISION_GLOBAL_MAX_CONCURRENCY=6

# API 登录令牌签名密钥。留空时系统会生成随机密钥并持久化到应用数据库。
# 多实例部署必须为所有后端实例配置相同的高强度随机值。
AUTH_SECRET_KEY=

# SQLite 中模型 API Key 的加密主密钥，必须至少 32 个字符。请为每套部署单独生成：
# openssl rand -hex 32
# 不要提交或丢失此值；只有数据库而没有该值时，无法恢复模型 API Key。
MODEL_API_KEY_ENCRYPTION_KEY=

# 轮换主密钥时临时填写旧密钥，多个值以英文逗号分隔。启动成功后数据库会使用
# 新主密钥重加密，确认服务正常后即可清空此项。
MODEL_API_KEY_PREVIOUS_ENCRYPTION_KEYS=

# 登录令牌有效期，单位秒，默认 8 小时。
AUTH_TOKEN_TTL_SECONDS=28800

# 登录与注册限流（进程内计数，重启后清零；次数或窗口设为 0 即关闭该项）。
# 同一用户名在窗口内连续密码错误达到次数后被锁定，默认 15 分钟内 5 次。
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=900
# 同一来源地址在窗口内的密码错误总数，用于拦截一个密码试很多用户名，默认 5 分钟内 20 次。
AUTH_CLIENT_MAX_FAILURES=20
AUTH_CLIENT_WINDOW_SECONDS=300
# 同一来源地址在窗口内的注册提交次数（无论成功与否），默认 1 小时内 5 次。
AUTH_REGISTER_MAX_ATTEMPTS=5
AUTH_REGISTER_WINDOW_SECONDS=3600
# 是否把 X-Real-IP 当作来源地址。Compose 内的 Nginx 会设置该请求头，docker-compose.yml
# 默认开启；后端代码默认关闭，直接暴露后端且前面没有可信代理时不要开启，否则请求头可被伪造。
AUTH_TRUST_X_REAL_IP=true

# 已完成、失败、被替代或中断的索引任务历史保留策略。
# 默认保留 90 天；程序允许的最小值为 1 天。
INDEX_JOB_HISTORY_RETENTION_DAYS=90
# 每个知识库默认最多保留 200 条终态任务；环境配置的最小值为 20。
INDEX_JOB_HISTORY_MAX_PER_KB=200

# 是否让聊天模型通过 function calling 决定本轮是否检索知识库。
# 默认关闭；仅在所选 OpenAI 兼容模型可靠支持 tools/function calling 时开启。
# 普通文本或无效工具响应会安全降级为强制检索，不会被当作“无需检索”。
CHAT_RETRIEVAL_PLANNING=false

# 是否在原问题之外，再生成一条口语转书面语的补充查询并合并召回。
# 默认关闭；开启后每轮提问会多一次改写模型调用。原问题始终参与检索和重排，
# 补充查询失败或丢失编号、数字时会被丢弃。
CHAT_QUERY_VARIANT=false
